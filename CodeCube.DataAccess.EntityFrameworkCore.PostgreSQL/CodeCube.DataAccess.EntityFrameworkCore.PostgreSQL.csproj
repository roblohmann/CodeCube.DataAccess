<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <VersionPrefix>9.0.10</VersionPrefix>
        <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
        <Authors>Rob Lohmann</Authors>
        <Company>Rob Lohmann</Company>
        <Description>
            Package containing generic functionality to access databases using Microsoft EntityframeworkCore with PostgreSQL server.
            
            For .NETCore 3.x grab version 1.x or higher
            For .NET6 grab version 6.x or higher
            For .NET7 and above, grab version 7.x or higher
        </Description>
        <Copyright>Copyright 2020 - 2026 Rob Lohmann</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/roblohmann/CodeCube.DataAccess</PackageProjectUrl>
        <PackageId>CodeCube.DataAccess.EntityFrameworkCore.PostgreSQL</PackageId>
        <PackageIcon>nuget-icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/roblohmann/CodeCube.DataAccess</RepositoryUrl>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|netstandard2.0|AnyCPU'">
        <DocumentationFile>CodeCube.DataAccess.EntityFrameworkCore.PostgreSQL.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'net6.0' ">
        <PackageReference Include="CodeCube.DataAccess.EntityFrameworkCore" VersionOverride="6.0.4" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <!-- Patched transitive dependency of Npgsql EF Core 6 (GHSA-qj66-m88j-hmgj) -->
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" />

        <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'net7.0' ">
        <PackageReference Include="CodeCube.DataAccess.EntityFrameworkCore" VersionOverride="7.0.1" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />

        <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
        <PackageReference Include="CodeCube.DataAccess.EntityFrameworkCore" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />

        <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'net9.0' ">
        <PackageReference Include="CodeCube.DataAccess.EntityFrameworkCore" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />

        <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    </ItemGroup>

    <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
        <PackageReference Include="CodeCube.DataAccess.EntityFrameworkCore" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />

        <PackageReference Include="Microsoft.Extensions.Configuration.FileExtensions" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" VersionOverride="10.0.5" />
    </ItemGroup>    
  <ItemGroup>
    <None Include="../nuget-icon.png" Pack="true" Visible="false" PackagePath="" />
  </ItemGroup>

</Project>
